---
import BookingForm from '../components/BookingForm.jsx';
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delta Aesthetics - Booking</title>
  </head>
  <body class="min-h-screen flex items-center justify-center p-4">
    <main class="w-full max-w-lg bg-slate-900 border border-slate-800 p-6 md:p-8 rounded-2xl shadow-2xl">
      <h1 class="text-2xl font-bold text-sky-400 mb-1">Book an Appointment</h1>
      <p class="text-xs text-slate-400 mb-6">Select a date to view available time slots.</p>
      
      <BookingForm client:load />
    </main>
  </body>
</html>