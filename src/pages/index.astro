---
import '../styles/global.css';
import BookingForm from '../components/BookingForm.jsx';
import ClientPortal from '../components/ClientPortal.jsx';
---

<!doctype html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delta Aesthetics | Electrology & Affirming Care</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 selection:bg-[#55CDFC]/30 selection:text-white flex flex-col justify-between">
    <div
      role="note"
      class="w-full bg-amber-400 text-slate-950 text-center text-sm font-semibold px-4 py-2"
    >
      Demo site: booking is not live yet. Please don't enter real personal information.
    </div>
    <header class="w-full border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-[#55CDFC] via-white to-[#F7A8B8] flex items-center justify-center font-bold text-slate-950 text-lg shadow-lg shadow-[#55CDFC]/10">
            Δ
          </div>
          <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-[#55CDFC] via-white to-[#F7A8B8] bg-clip-text text-transparent">
            Delta Aesthetics
          </span>
        </div>

        <div class="flex items-center gap-3">
          <button
            id="open-portal-btn"
            class="text-xs font-semibold text-slate-300 hover:text-white px-3 py-2 rounded-xl transition cursor-pointer"
          >
            Client Portal
          </button>
          <a
            href="#booking"
            class="text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-[#55CDFC] px-4 py-2 rounded-xl border border-[#55CDFC]/30 transition-all shadow-sm"
          >
            Book Appointment
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12 md:py-20 flex-grow">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#55CDFC]/10 border border-[#55CDFC]/30 text-[#55CDFC] text-xs font-medium tracking-wide">
              <span class="w-2 h-2 rounded-full bg-[#55CDFC] animate-pulse"></span>
              Gender-Affirming & Inclusive Electrology
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-50 leading-[1.15]">
              Permanent hair removal in a safe,{' '}
              <span class="bg-gradient-to-r from-[#55CDFC] to-[#F7A8B8] bg-clip-text text-transparent">
                welcoming space.
              </span>
            </h1>
            <p class="text-slate-400 text-base md:text-lg leading-relaxed">
              Delta Aesthetics provides dedicated, precision electrology treatments engineered for
              long-term comfort and confidence. We prioritize personalized care tailored to your
              specific goals in an environment designed by and for our community.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 space-y-4 shadow-xl backdrop-blur-sm">
            <h3 class="font-semibold text-sm uppercase tracking-wider text-[#55CDFC]">
              Our Commitment
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Whether preparing for gender-affirming procedures, managing sensitive areas, or
              pursuing permanent smoothness, we provide meticulous care with top-tier technology and
              transparent scheduling.
            </p>
          </div>
        </div>

        <div
          id="booking"
          class="lg:col-span-7 bg-slate-900/90 border border-slate-800 p-6 md:p-10 rounded-3xl shadow-2xl shadow-[#55CDFC]/5 relative backdrop-blur-md"
        >
          <div class="mb-8 pb-6 border-b border-slate-800/80">
            <h2 class="text-2xl font-bold text-slate-50">Reserve Your Slot</h2>
            <p class="text-xs text-slate-400 mt-1">
              Choose an available date below to view open appointment windows.
            </p>
          </div>

          <BookingForm client:load />
        </div>
      </div>
    </main>

    <div
      id="portal-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="portal-title"
      class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4"
    >
      <ClientPortal client:load modalId="portal-modal" />
    </div>

    <script>
      const portalModal = document.getElementById('portal-modal');

      document.getElementById('open-portal-btn')?.addEventListener('click', () => {
        portalModal?.classList.remove('hidden');
      });

      portalModal?.addEventListener('click', (e) => {
        if (e.target === portalModal) portalModal.classList.add('hidden');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') portalModal?.classList.add('hidden');
      });
    </script>

    <footer class="border-t border-slate-900 bg-slate-950 py-8 text-center text-xs text-slate-400 mt-20">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} Delta Aesthetics LLC. All rights reserved.</p>
        <div class="flex items-center gap-1.5 opacity-60">
          <span class="w-3 h-2 bg-[#55CDFC] rounded-sm inline-block"></span>
          <span class="w-3 h-2 bg-white rounded-sm inline-block"></span>
          <span class="w-3 h-2 bg-[#F7A8B8] rounded-sm inline-block"></span>
        </div>
      </div>
    </footer>
  </body>
</html>
