---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.jsx';
---

<Layout title="Delta Aesthetics | Electrology & Affirming Care" description="">
  <main class="max-w-6xl mx-auto px-6 py-12 md:py-20 flex-grow">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#55CDFC]/10 border border-[#55CDFC]/30 text-[#55CDFC] text-xs font-medium tracking-wide">
            <span class="w-2 h-2 rounded-full bg-[#55CDFC] animate-pulse"></span>
            Gender-Affirming & Inclusive Electrology
          </div>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-50 leading-[1.15]">
            Permanent hair removal in a safe,{' '}
            <span class="bg-gradient-to-r from-[#55CDFC] to-[#F7A8B8] bg-clip-text text-transparent">
              welcoming space.
            </span>
          </h1>
          <p class="text-slate-400 text-base md:text-lg leading-relaxed">
            Delta Aesthetics provides dedicated, precision electrology treatments engineered for
            long-term comfort and confidence. We prioritize personalized care tailored to your
            specific goals in an environment designed by and for our community.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 space-y-4 shadow-xl backdrop-blur-sm">
          <h3 class="font-semibold text-sm uppercase tracking-wider text-[#55CDFC]">
            Our Commitment
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Whether preparing for gender-affirming procedures, managing sensitive areas, or pursuing
            permanent smoothness, we provide meticulous care with top-tier technology and
            transparent scheduling.
          </p>
        </div>
      </div>

      <div
        id="booking"
        class="lg:col-span-7 bg-slate-900/90 border border-slate-800 p-6 md:p-10 rounded-3xl shadow-2xl shadow-[#55CDFC]/5 relative backdrop-blur-md"
      >
        <div class="mb-8 pb-6 border-b border-slate-800/80">
          <h2 class="text-2xl font-bold text-slate-50">Reserve Your Slot</h2>
          <p class="text-xs text-slate-400 mt-1">
            Choose an available date below to view open appointment windows.
          </p>
        </div>

        <BookingForm client:load />
      </div>
    </div>
  </main>
</Layout>
